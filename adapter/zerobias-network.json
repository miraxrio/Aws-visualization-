      "label": "egress",
      "kind": "egress"
    },
    {
      "from": "internet",
      "to": "edge-fw",
      "label": ":443",
      "kind": "internet"
    },
    {
      "from": "internet",
      "to": "web-alb",
      "label": ":443",
      "kind": "internet"
    },
    {
      "from": "edge-fw",
      "to": "web-alb",
      "label": "HTTPS 443"
    },
    {
      "from": "web-alb",
      "to": "api-1",
      "label": "HTTP 8080"
    },
    {
      "from": "web-alb",
      "to": "api-2",
      "label": "HTTP 8080"
    },
    {
      "from": "api-1",
      "to": "pg-primary",
      "label": "5432"
    },
    {
      "from": "api-2",
      "to": "pg-primary",
      "label": "5432"
    },
    {
      "from": "api-1",
      "to": "redis-cache",
      "label": "6379 cache"
    }
  ]
