        },
        {
          "id": "api-1",
          "type": "ecs",
          "name": "api-svc-1",
          "subnet": "seg-app"
        },
        {
          "id": "api-2",
          "type": "ecs",
          "name": "api-svc-2",
          "subnet": "seg-app"
        },
        {
          "id": "pg-primary",
          "type": "rds",
          "name": "pg-primary",
          "subnet": "seg-data"
        },
        {
          "id": "redis-cache",
          "type": "redis",
          "name": "redis-cache",
          "subnet": "seg-data"
        }
      ]
