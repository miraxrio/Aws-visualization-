          "cidr": "10.0.21.0/24",
          "tier": "data",
          "az": "us-east-1a"
        }
      ],
      "gateways": [
        {
          "id": "igw-net-prod",
          "type": "igw",
          "name": "Internet Gateway"
        },
        {
          "id": "nat-seg-dmz",
          "type": "nat",
          "name": "NAT us-east-1a",
          "subnet": "seg-dmz"
        }
      ],
      "resources": [
        {
          "id": "edge-fw",
