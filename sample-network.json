        "tour": [
          {
            "id": "vpc-prod",
            "stage": "Overview",
            "title": "The production network",
            "narration": "Let's start with the big picture. Everything you're looking at lives inside one private network in the cloud, carved into three availability zones, so that if an entire data centre goes offline, your service simply keeps running.",
            "audio": "assets/tutorial/tour-1.mp3"
          },
          {
            "id": "cdn",
            "stage": "Entry point",
            "title": "Content delivery edge",
            "narration": "Visitors always arrive here first, at the content delivery edge. It serves cached pages from wherever the user happens to be in the world, and shrugs off sudden traffic spikes long before they reach your own machines.",
            "audio": "assets/tutorial/tour-2.mp3"
          },
          {
            "id": "alb",
            "stage": "Routing",
            "title": "Load balancer",
            "narration": "Requests then hand off to the load balancer. Its whole job is fairness: sharing visitors evenly between your servers, and quietly steering around any instance that stops responding.",
            "audio": "assets/tutorial/tour-3.mp3"
          },
          {
            "id": "api-gw",
            "stage": "Partners",
            "title": "Partner API gateway",
            "narration": "Outside partners take a different route. Their automated callbacks come through a dedicated gateway that checks who's calling before letting anything through.",
            "audio": "assets/tutorial/tour-4.mp3"
          },
          {
            "id": "app-a",
            "stage": "Compute",
            "title": "Application tasks",
            "narration": "Here is where your code actually runs. These are containerised tasks handling the application logic, and copies live in every zone, so a single failure never stops the show.",
            "audio": "assets/tutorial/tour-5.mp3"
          },
          {
            "id": "cache",
            "stage": "Caching",
            "title": "In-memory cache",
            "narration": "Speed comes from this in-memory cache. Anything read often is kept right here and returned in a heartbeat, which saves the database from answering the same request a thousand times.",
            "audio": "assets/tutorial/tour-6.mp3"
          },
          {
            "id": "search-svc",
            "stage": "Search",
            "title": "Search service",
            "narration": "Searching gets its own engine. It maintains a separate index built for fast text lookups, keeping that heavy work away from your main database.",
            "audio": "assets/tutorial/tour-7.mp3"
          },
          {
            "id": "rds-w",
            "stage": "Data",
            "title": "Primary database",
            "narration": "This is the source of truth. A single primary database accepts every write, while read replicas in the neighbouring zones share the reading load and wait, ready to step up if the primary ever stumbles.",
            "audio": "assets/tutorial/tour-8.mp3"
          },
          {
            "id": "sessions",
            "stage": "State",
            "title": "Sessions and audit log",
            "narration": "Some data doesn't fit neatly into rows. Login sessions are kept in a quick key-value store, and every meaningful action is appended to a permanent audit trail for compliance.",
            "audio": "assets/tutorial/tour-9.mp3"
          },
          {
            "id": "nat-1a",
            "stage": "Egress",
            "title": "NAT gateway",
            "narration": "When something inside needs to call out to the wider internet, it leaves through this gateway. Traffic can go out, but nothing out there can use the same path to sneak back in.",
            "audio": "assets/tutorial/tour-10.mp3"
          },
          {
            "id": "igw-prod",
            "stage": "The door",
